--track@size:サイズ,0,500,7,1
--track@grd_x:中心X,-5000,5000,0,0.1
--track@grd_y:中心Y,-5000,5000,0,0.1
--track@grd_rotate:角度,-3600,3600,0,0.01
--track@grd_width:幅,0,2000,100,1
--color@grd_start_col:開始色,0xff3232
--color@grd_end_col:終了色,0xffdc32

--[[pixelshader@psmain:
Texture2D tex : register(t0);
SamplerState samp : register(s0);

cbuffer constant0 : register(b0) {
    float w;
    float h;
    float cx;
    float cy;
    float angle;
    float width;
    float pad1;
    float pad2;
    float4 color1;
    float4 color2;
};

float4 psmain(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float4 col = tex.Sample(samp, uv);
    if (col.a == 0.0) return col;
    
    float2 p_pos = float2(uv.x * w, uv.y * h);
    float2 center = float2(w * 0.5 + cx, h * 0.5 + cy);
    float2 p = p_pos - center;
    
    float rad = angle * 3.14159265359 / 180.0;
    float c = cos(rad);
    float s = sin(rad);
    
    float u = p.x * c - p.y * s;
    
    float t = 0.5;
    if (width > 0.0) {
        t = u / width + 0.5;
    } else {
        t = (u > 0.0) ? 1.0 : 0.0;
    }
    t = saturate(t);
    
    float4 gradCol = lerp(color1, color2, t);
    return float4(gradCol.rgb, col.a);
}
]]

obj.copybuffer("cache:grd_frame_text","obj")

local ow,oh = 0,0
if AKIRA_h then
    ow,oh = AKIRA_h.get_text_size()
else
    ow,oh = obj.w, obj.h
end
local add_w,add_h = size *5,size *5

obj.setoption("drawtarget", "tempbuffer", ow+add_w, oh+add_h)
obj.clearbuffer("tempbuffer")

obj.effect(
    "縁取り",
    "サイズ", math.max(0,size),
    "ぼかし", 0,
    "縁色",   0xffffff
)

local function hex2rgba_unpack(hex)
    if not hex then return 1.0, 1.0, 1.0, 1.0 end
    local r = math.floor(hex / 65536) / 255.0
    local g = math.floor((hex % 65536) / 256) / 255.0
    local b = (hex % 256) / 255.0
    return r, g, b, 1.0
end

local c1r, c1g, c1b, c1a = hex2rgba_unpack(grd_start_col)
local c2r, c2g, c2b, c2a = hex2rgba_unpack(grd_end_col)

local constants = {
    obj.w, obj.h,
    grd_x, grd_y,
    grd_rotate, grd_width,
    0, 0, -- padding
    c1r, c1g, c1b, c1a,
    c2r, c2g, c2b, c2a
}

obj.pixelshader("psmain", "object", "object", constants, "copy", "clamp")

local ox,oy,oz,cx,cy,cz = obj.ox,obj.oy,obj.oz,obj.cx,obj.cy,obj.cz
local zoom = 1
obj.draw(ox,oy,oz,zoom)

obj.copybuffer("obj","cache:grd_frame_text")
obj.draw(ox,oy,oz,zoom)

obj.load("tempbuffer")